# NovaTV boot splash. Generated by tools/render-plymouth.js from tools/plymouth-template.script.
# The logo is drawn from crisp images at the screen's own resolution: the spark rises in,
# the wordmark slides in, then three small dots pulse until the interface takes over.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

if (Window.GetHeight() >= 1800) { sfx = "-2x"; u = 2; }
else { sfx = ""; u = 1; }

spark_img = Image("spark" + sfx + ".png");
word_img = Image("word" + sfx + ".png");
dot_img = Image("dot" + sfx + ".png");

# for screens that are neither 1080p nor 2160p, keep the logo the same share of the screen
k = Window.GetHeight() / (1080 * u);
if (k < 0.97 || k > 1.03) {
  spark_img = spark_img.Scale(spark_img.GetWidth() * k, spark_img.GetHeight() * k);
  word_img = word_img.Scale(word_img.GetWidth() * k, word_img.GetHeight() * k);
  dot_img = dot_img.Scale(dot_img.GetWidth() * k, dot_img.GetHeight() * k);
}
else k = 1;
s = u * k;   # 1080p pixels -> screen pixels

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

spark_x = cx - 232 * s;
spark_y = cy - 67 * s;
word_x = cx - 98 * s;
word_y = cy - 62 * s;

spark = Sprite(spark_img);
spark.SetPosition(spark_x, spark_y, 10);
spark.SetOpacity(0);
word = Sprite(word_img);
word.SetPosition(word_x, word_y, 10);
word.SetOpacity(0);

for (i = 0; i < 3; i++) {
  dots[i] = Sprite(dot_img);
  dots[i].SetPosition(cx + (i - 1) * 22 * s - dot_img.GetWidth() / 2, cy + 150 * s, 10);
  dots[i].SetOpacity(0);
}

fun ease(v) {
  if (v < 0) v = 0;
  if (v > 1) v = 1;
  return 1 - (1 - v) * (1 - v) * (1 - v);
}

t = 0;
fun refresh_callback() {
  global.t++;                        # called 50 times per second
  a = ease(t / 45);
  spark.SetOpacity(a);
  spark.SetY(spark_y + (1 - a) * 16 * s);
  b = ease((t - 12) / 45);
  word.SetOpacity(b);
  word.SetX(word_x - (1 - b) * 20 * s);
  d = ease((t - 75) / 30);
  for (i = 0; i < 3; i++) {
    p = Math.Sin((t - i * 9) * Math.Pi * 2 / 70);
    if (p < 0) p = 0;
    dots[i].SetOpacity(d * (0.18 + 0.62 * p));
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# hand over to the interface with the plain logo on screen (the launcher starts from it)
fun quit_callback() {
  spark.SetOpacity(1); spark.SetY(spark_y);
  word.SetOpacity(1); word.SetX(word_x);
  for (i = 0; i < 3; i++) dots[i].SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);

fun message_callback(text) { }
Plymouth.SetMessageFunction(message_callback);

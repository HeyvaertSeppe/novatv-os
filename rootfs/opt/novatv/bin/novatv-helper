#!/bin/bash
# Root helper for the NovaTV server (runs as user "tv" through sudo, see /etc/sudoers.d/novatv).
# Only the actions below are allowed, each with a strict argument check.
set -euo pipefail
case "${1:-}" in
  wifi-country)
    [[ "${2:-}" =~ ^[A-Z]{2}$ ]] || exit 2
    raspi-config nonint do_wifi_country "$2" >/dev/null 2>&1 || iw reg set "$2" || true
    rfkill unblock wifi || true
    nmcli radio wifi on || true
    ;;
  timezone)
    [[ "${2:-}" =~ ^[A-Za-z_]+/[A-Za-z_]+$ ]] && [ -f "/usr/share/zoneinfo/$2" ] || exit 2
    timedatectl set-timezone "$2"
    ;;
  keyboard)
    [[ "${2:-}" =~ ^[a-z]{2,3}$ ]] || exit 2
    if grep -q '^XKBLAYOUT=' /etc/default/keyboard 2>/dev/null; then
      sed -i "s/^XKBLAYOUT=.*/XKBLAYOUT=\"$2\"/; s/^XKBVARIANT=.*/XKBVARIANT=\"\"/" /etc/default/keyboard
    else
      printf 'XKBMODEL="pc105"\nXKBLAYOUT="%s"\nXKBVARIANT=""\nXKBOPTIONS=""\n' "$2" > /etc/default/keyboard
    fi
    ;;
  hostname)
    [[ "${2:-}" =~ ^[a-z0-9][a-z0-9-]{0,29}$ ]] || exit 2
    hostnamectl set-hostname "$2"
    sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t$2/" /etc/hosts
    systemctl try-restart avahi-daemon.service || true
    ;;
  display-boot)
    # resolution used from power-on (boot animation included): video= in cmdline.txt
    MODE="${2:-}"
    [[ "$MODE" == auto || "$MODE" =~ ^[0-9]{3,4}x[0-9]{3,4}@[0-9.]+$ ]] || exit 2
    CMD=/boot/firmware/cmdline.txt
    [ -f "$CMD" ] || exit 0
    sed -i -E 's/ ?video=HDMI-A-[12]:[^ ]*//g' "$CMD"
    if [ "$MODE" != auto ]; then
      RATE=$(printf '%.0f' "${MODE#*@}")
      RES="${MODE%@*}"
      sed -i "1 s|\$| video=HDMI-A-1:${RES}@${RATE} video=HDMI-A-2:${RES}@${RATE}|" "$CMD"
    fi
    ;;
  cec)
    # TV control over HDMI-CEC: on | off | switch | restart
    DEV=$(python3 -c "import json; print(json.load(open('/run/novatv-cec.json')).get('device',''))" 2>/dev/null)
    PA=$(python3 -c "import json; print(json.load(open('/run/novatv-cec.json')).get('phys_addr',''))" 2>/dev/null)
    case "${2:-}" in
      restart) systemctl restart novatv-cec.service ;;
      on)      [ -n "$DEV" ] && cec-ctl -d "$DEV" --to 0 --image-view-on ;;
      off)     [ -n "$DEV" ] && cec-ctl -d "$DEV" --to 0 --standby ;;
      switch)  [ -n "$DEV" ] && cec-ctl -d "$DEV" --to 0 --image-view-on && cec-ctl -d "$DEV" --to 0 --active-source "phys-addr=$PA" ;;
      *) exit 2 ;;
    esac
    ;;
  restart-ui)
    systemctl reset-failed novatv-ui.service 2>/dev/null || true
    systemctl restart novatv-ui.service
    ;;
  fan)
    # Fan curve for the Pi 5 fan connector (official Active Cooler or a case fan).
    # Written to config.txt (used from the next start) and applied right away where the
    # kernel allows changing the trip temperatures live.
    case "${2:-}" in
      quiet)    T=(55000 65000 72000 78000); SP=(75 125 175 250) ;;
      balanced) T=(50000 60000 67500 75000); SP=(75 125 175 250) ;;
      cool)     T=(40000 50000 60000 68000); SP=(90 140 190 255) ;;
      max)      T=(30000 35000 40000 45000); SP=(175 200 230 255) ;;
      *) exit 2 ;;
    esac
    CFG=/boot/firmware/config.txt
    if [ -f "$CFG" ]; then
      sed -i '/^# --- NovaTV fan ---$/,/^# --- end NovaTV fan ---$/d' "$CFG"
      {
        echo "# --- NovaTV fan ---"
        echo "[all]"
        for i in 0 1 2 3; do
          echo "dtparam=fan_temp$i=${T[$i]},fan_temp${i}_hyst=5000,fan_temp${i}_speed=${SP[$i]}"
        done
        echo "# --- end NovaTV fan ---"
      } >> "$CFG"
    fi
    LIVE=0
    [ "${NOVATV_FAN_LIVE:-1}" = 1 ] || { echo "live=0"; exit 0; }
    Z=/sys/class/thermal/thermal_zone0
    n=0
    for f in "$Z"/trip_point_*_type; do
      [ -e "$f" ] || continue
      [ "$(cat "$f")" = active ] || continue
      idx=${f##*trip_point_}; idx=${idx%_type}
      [ $n -lt 4 ] || break
      if [ -w "$Z/trip_point_${idx}_temp" ] && echo "${T[$n]}" > "$Z/trip_point_${idx}_temp" 2>/dev/null; then LIVE=1; fi
      n=$((n + 1))
    done
    echo "live=$LIVE"
    ;;
  reboot) systemctl reboot ;;
  poweroff) systemctl poweroff ;;
  *) echo "unknown action" >&2; exit 2 ;;
esac

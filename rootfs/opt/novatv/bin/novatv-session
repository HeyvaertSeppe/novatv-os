#!/bin/bash
# NovaTV kiosk session, started on the TV screen (tty1) by novatv-ui.service.
# cage is a Wayland kiosk compositor: it shows one fullscreen app, here Chromium.
# When Chromium or cage exits, systemd starts this again within a second.

LOG="$HOME/.cache/novatv-session.log"
mkdir -p "$HOME/.cache"
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.1"
exec >"$LOG" 2>&1
echo "NovaTV session start $(date '+%F %T') (uptime $(cut -d' ' -f1 /proc/uptime)s)"

# Keyboard layout chosen during setup (written to /etc/default/keyboard)
if [ -r /etc/default/keyboard ]; then
  . /etc/default/keyboard
  export XKB_DEFAULT_LAYOUT="${XKBLAYOUT:-us}"
  [ -n "${XKBVARIANT:-}" ] && export XKB_DEFAULT_VARIANT="$XKBVARIANT"
fi
export XDG_SESSION_TYPE=wayland
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WLR_LIBINPUT_NO_DEVICES=1   # start fine with no keyboard or mouse plugged in
export MOZ_ENABLE_WAYLAND=1

# Use the display driver's card. A Pi 5 also has a render-only GPU card (v3d), and right
# after power-on the display driver can need a moment, so wait for its HDMI connectors.
CARD=""
for _ in $(seq 1 60); do
  for c in /sys/class/drm/card[0-9]; do
    if compgen -G "$c-HDMI-A-*" >/dev/null; then CARD="/dev/dri/${c##*/}"; break 2; fi
  done
  sleep 0.25
done
if [ -n "$CARD" ]; then
  export WLR_DRM_DEVICES="$CARD"
  echo "display: $CARD ($(cat /sys/class/drm/${CARD##*/}-HDMI-A-*/status 2>/dev/null | tr '\n' ' '))"
else
  echo "display: no HDMI display driver found, letting the compositor pick"
fi

# Keep the mode the kernel set (no TV re-sync) and keep the boot logo on screen until the
# launcher has drawn its first frame (the server creates the "ready" file). Only the cage
# built by NovaTV (/usr/local/bin/cage) knows these; the packaged one ignores them.
# Safety net: if the interface twice failed to appear (the server removes the marker once
# the page is on screen), start the plain way, without keeping the mode or the splash.
MARK=/var/lib/novatv/ui-starting
TRIES=$(cat "$MARK" 2>/dev/null || echo 0)
echo $((TRIES + 1)) > "$MARK" 2>/dev/null
rm -f "$XDG_RUNTIME_DIR/novatv-ready"
if [ "$TRIES" -lt 2 ]; then
  export CAGE_KEEP_MODE=1
  export CAGE_HOLD_UNTIL="$XDG_RUNTIME_DIR/novatv-ready"
else
  echo "safe start: interface did not appear the last $TRIES times"
fi
CAGE=/usr/local/bin/cage
[ -x "$CAGE" ] || CAGE=cage

exec "$CAGE" -d -s -- /opt/novatv/bin/novatv-browser

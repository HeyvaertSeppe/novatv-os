+/* NovaTV: keep showing the boot splash until the interface has drawn its first frame.
+ * CAGE_HOLD_UNTIL names a file that NovaTV creates once its page is painted; until then
+ * (or for at most 25 seconds) nothing is put on screen, so the TV goes straight from the
+ * boot logo to the interface without a black or grey screen in between. */
+#define NOVATV_HOLD_MAX_SEC 25
+static bool novatv_hold_done = false;
+static struct timespec novatv_hold_start = {0};
+static struct wl_event_source *novatv_hold_timer = NULL;
+
+static bool
+novatv_holding(void)
+{
+	if (novatv_hold_done) {
+		return false;
+	}
+	const char *file = getenv("CAGE_HOLD_UNTIL");
+	struct timespec now = {0};
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	if (novatv_hold_start.tv_sec == 0) {
+		novatv_hold_start = now;
+	}
+	if (!file || !*file || access(file, F_OK) == 0 || now.tv_sec - novatv_hold_start.tv_sec >= NOVATV_HOLD_MAX_SEC) {
+		novatv_hold_done = true;
+		wlr_log(WLR_INFO, "NovaTV: showing the interface");
+		return false;
+	}
+	return true;
+}
+
+static int
+novatv_hold_tick(void *data)
+{
+	struct cg_server *server = data;
+	struct cg_output *output;
+	wl_list_for_each (output, &server->outputs, link) {
+		wlr_output_schedule_frame(output->wlr_output);
+	}
+	if (!novatv_hold_done) {
+		wl_event_source_timer_update(novatv_hold_timer, 100);
+	}
+	return 0;
+}
+
 static void
 handle_output_frame(struct wl_listener *listener, void *data)
 {
@@ -141,6 +185,14 @@
